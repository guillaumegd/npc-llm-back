MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_AGENT_INTENT_CLASSIFIER=

# Embeddings / RAG
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_TOP_K=3
EMBEDDING_VECTOR_SIZE=1536

# Qdrant config
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=npc_rag

# KB / memory options
KB_RETENTION_DAYS=90
KB_AUTO_INDEX=false
